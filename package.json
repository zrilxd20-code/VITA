{
  "name": "vita-forgotten-sector",
  "version": "2.6.7",
  "description": "VITA — Forgotten Sector. Web-only top-down survival horror maze roguelite. Zero external runtime assets.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "relay": "node tools/relay.mjs",
    "check": "node tools/check.mjs && node tools/check_html.cjs",
    "check:html": "node tools/check_html.cjs",
    "test": "node tests/test_web_security_qa.js",
    "icons": "node tools/gen-icons.mjs",
    "icons:android": "node tools/gen-android-icons.mjs",
    "icons:desktop": "node tools/gen-desktop-icons.mjs",
    "bump": "node tools/bump-version.mjs",
    "build:www": "node tools/build-www.mjs",
    "cap:sync": "cap sync android",
    "apk:debug": "npm run build:www && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3"
  }
}
